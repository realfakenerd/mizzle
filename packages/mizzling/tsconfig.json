{
  "extends": "@mizzle/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@mizzle/shared": ["./../shared/src/index.ts"],
      "@aurios/mizzle": ["./../mizzle/src/index.ts"],
      "@aurios/mizzle/columns": ["./../mizzle/src/columns/index.ts"],
      "@aurios/mizzle/table": ["./../mizzle/src/core/table.ts"],
      "@aurios/mizzle/snapshot": ["./../mizzle/src/core/snapshot.ts"],
      "@aurios/mizzle/diff": ["./../mizzle/src/core/diff.ts"],
      "@aurios/mizzle/introspection": ["./../mizzle/src/core/introspection.ts"],
