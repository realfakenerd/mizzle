{
  "name": "mizzle",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./columns": {
      "types": "./dist/columns.d.ts",
      "import": "./dist/columns.js",
      "require": "./dist/columns.cjs"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js",
      "require": "./dist/table.cjs"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js",
      "require": "./dist/snapshot.cjs"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "import": "./dist/diff.js",
      "require": "./dist/diff.cjs"
    },
    "./introspection": {
      "types": "./dist/introspection.d.ts",
      "import": "./dist/introspection.js",
      "require": "./dist/introspection.cjs"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "require": "./dist/db.cjs"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.962.0",
    "@aws-sdk/lib-dynamodb": "3.962.0"
  },
  "devDependencies": {
    "@mizzle/eslint-config": "workspace:*",
    "@mizzle/shared": "workspace:*",
    "@mizzle/tsconfig": "workspace:*",
    "tsup": "^8.5.1"
  }
}
