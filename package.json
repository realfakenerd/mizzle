{
    "name": "mizzle",
    "type": "module",
    "workspaces": [
        "packages/*",
        "docs",
        "benchmark"
    ],
    "scripts": {
        "build": "turbo run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "bench": "vitest bench",
        "check": "turbo run check && bun run check:root",
        "check:root": "tsc --noEmit",
        "lint": "turbo run lint && bun run lint:root",
        "check:turbo": "turbo run check check:root",
        "lint:turbo": "turbo run lint lint:root",
        "lint:root": "bunx oxlint --type-aware test",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish"
    },
    "packageManager": "bun@1.3.7",
    "devDependencies": {
        "@aurios/mizzle": "workspace:*",
        "@aws-sdk/client-dynamodb": "3.962.0",
        "@aws-sdk/lib-dynamodb": "3.962.0",
        "@changesets/cli": "^2.29.8",
        "@mizzle/eslint-config": "workspace:*",
        "@mizzle/shared": "workspace:*",
        "@mizzle/tsconfig": "workspace:*",
        "@types/bun": "latest",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "@vitest/coverage-v8": "4.0.16",
        "eslint": "^8.57.1",
        "eslint-plugin-turbo": "latest",
        "oxlint-tsgolint": "^0.11.2",
        "tsx": "^4.21.0",
        "turbo": "^2.7.6",
        "vitest": "^4.0.18"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@aws-sdk/credential-provider-ini": "3.962.0",
        "@clack/prompts": "^0.11.0",
        "astro-mermaid": "^1.3.1",
        "commander": "^14.0.2",
        "mermaid": "^11.12.2",
        "starlight-llms-txt": "^0.7.0",
        "uuid": "^13.0.0"
    }
}
