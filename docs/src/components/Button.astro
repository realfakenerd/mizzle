---
import { Icon } from "@astrojs/starlight/components";
import type { ComponentProps } from 'astro/types';
import {
    custom,
    literal,
    object,
    optional,
    string,
    union,
    enum as _enum,
    parse,
} from "valibot";

type IconProps = ComponentProps<typeof Icon>;
type IconName = IconProps["name"];

interface Props {
    variant: "primary" | "secondary" | "minimal";
    link: string;
    icon?:
        | undefined
        | { type: "icon"; name: IconName }
        | { type: "raw"; html: string };
}

const propsSchema = object({
    variant: _enum({
        primary: "primary",
        secondary: "secondary",
        minimal: "minimal",
    }),
    link: string(),
    icon: optional(
        union([
            object({
                type: literal("icon"),
                name: custom<IconName>((i) => typeof i === "string"),
            }),
            object({ type: literal("raw"), html: string() }),
        ]),
    ),
});

const { link, variant, icon } = parse(propsSchema, Astro.props);
---

<a
    class:list={[
        "flex action gap-2 items-center rounded-full py-2 px-5 text-sm ",
        "md:px-4 md:text-base",
        variant === "minimal" ? "px-0" : "",
        variant === "primary" ? "bg-accent text-gray-100" : "",
        variant === "secondary" ? "bg-black border-2" : "",
    ]}
    href={link}
>
    <slot />
    {icon?.type === "icon" && <Icon name={icon.name} size="1.5em" />}
    {icon?.type === "raw" && <Fragment set:html={icon.html} />}
</a>

<style>
    a {
        text-decoration: none;
    }
</style>
