{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ],
            "inputs": [
                "src/**",
                "public/**",
                "package.json",
                "tsconfig.json",
                "*.config.*"
            ]
        },
        "test": {
            "dependsOn": [
                "^test",
                "@repo/vitest-config#build"
            ]
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "//#lint": {},
        "//#lint:fix": {},
        "//#format": {},
        "//#format:fix": {},
        "//#quality": {
            "dependsOn": [
                "//#lint",
                "//#format"
            ]
        },
        "//#quality:fix": {
            "dependsOn": [
                "//#lint:fix",
                "//#format:fix"
            ]
        },
        "check": {
            "inputs": [
                "src/**",
                "test/**",
                "public/**",
                "package.json",
                "tsconfig.json",
                "*.config.*"
            ]
        },
        "check:root": {
            "inputs": [
                "src/**",
                "test/**",
                "public/**",
                "package.json",
                "tsconfig.json",
                "*.config.*"
            ]
        }
    }
}
