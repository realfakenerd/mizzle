{
    "$schema": "https://unpkg.com/@changesets/config@3.1.2/schema.json",
    "changelog": [
        "@svitejs/changesets-changelog-github-compact",
        {
            "repo": "realfakenerd/mizzle"
        }
    ],
    "commit": false,
    "fixed": [
        [
            "@aurios/mizzle",
            "@aurios/mizzling"
        ]
    ],
    "linked": [],
    "access": "public",
    "baseBranch": "main",
    "updateInternalDependencies": "patch",
    "bumpVersionsWithWorkspaceProtocolOnly": true,
    "ignore": [
        "docs",
        "@mizzle/benchmark"
    ]
}
